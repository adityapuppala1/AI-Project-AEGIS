{
  "realm": "aegis-exercise",
  "enabled": true,
  "displayName": "AEGIS LOCAL SYNTHETIC EXERCISE",
  "sslRequired": "all",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "passwordPolicy": "length(12)",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 900,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyInitialCounter": 0,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "otpPolicyCodeReusable": false,
  "otpSupportedApplications": [
    "totpAppFreeOTPName",
    "totpAppGoogleName",
    "totpAppMicrosoftAuthenticatorName"
  ],
  "roles": {
    "client": {
      "aegis-local-web": [
        {
          "name": "incident_operator"
        },
        {
          "name": "incident_checker"
        },
        {
          "name": "incident_auditor"
        },
        {
          "name": "platform_admin"
        },
        {
          "name": "department_operator"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "aegis-local-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:3000/api/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "aegis-resource-server",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "signed-demo-agency",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "aegis_agency_id",
            "claim.value": "11111111-1111-4111-8111-111111111111",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "signed-app-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "aegis-local-web",
            "claim.name": "aegis_roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "signed-department",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "aegis_department_id",
            "claim.name": "aegis_department_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "exercise-maker",
      "enabled": true,
      "requiredActions": [
        "UPDATE_PASSWORD",
        "CONFIGURE_TOTP"
      ],
      "clientRoles": {
        "aegis-local-web": [
          "incident_operator"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "${AEGIS_MAKER_PASSWORD}",
          "temporary": true
        }
      ]
    },
    {
      "username": "exercise-admin",
      "enabled": true,
      "requiredActions": [
        "UPDATE_PASSWORD",
        "CONFIGURE_TOTP"
      ],
      "clientRoles": {
        "aegis-local-web": [
          "platform_admin"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "${AEGIS_ADMIN_PASSWORD}",
          "temporary": true
        }
      ]
    },
    {
      "username": "exercise-checker",
      "enabled": true,
      "requiredActions": [
        "UPDATE_PASSWORD",
        "CONFIGURE_TOTP"
      ],
      "clientRoles": {
        "aegis-local-web": [
          "incident_checker"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "${AEGIS_CHECKER_PASSWORD}",
          "temporary": true
        }
      ]
    }
  ],
  "clientScopeMappings": {
    "aegis-local-web": [
      {
        "client": "aegis-local-web",
        "roles": [
          "incident_operator",
          "incident_checker",
          "incident_auditor",
          "platform_admin"
        ]
      }
    ]
  },
  "loginTheme": "aegis"
}
