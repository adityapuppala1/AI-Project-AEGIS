# AEGIS LOCAL EXERCISE ONLY. Copy to .env and keep .env untracked.
# Never reuse this development-only database password for production.
POSTGRES_PASSWORD=aegis_local_only

# Optional approved Identity Provider configuration.
# Leave all three unset to disable the protected proposal endpoints.
# Identity provider access tokens must contain signed AEGIS-specific
# agency UUID and roles. See docs/OIDC_IDENTITY_AND_AUTHORIZATION.md.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# Browser SSO BFF settings (optional; protected workbench remains locked without these).
APP_ORIGIN=http://localhost:3000
OIDC_CLIENT_ID=
# Confidential client credential, if explicitly required by the IdP.
OIDC_CLIENT_SECRET=
# 32 cryptographically random bytes, base64-encoded. NEVER commit the real value.
# Windows PowerShell:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
BFF_SESSION_KEY_BASE64=
